---
import { getFeaturedProjects } from '../../data/featured';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import DotPad from '../../components/DotPad.astro';
import ItemList from '../../components/ItemList.astro';
import Buttons from '../../components/Buttons.astro';
import { PAGES } from '../../data/pages';
import { inline } from '../../data/inline';
import { awards, certs } from '../../data/profile';

const page = PAGES.en;
const featured = await getFeaturedProjects();
---

<Base lang="en" title={page.title} description={page.description}>
  <section class="grid items-center gap-10 py-12 md:grid-cols-2">
    <div>
      <p class="text-sm text-zinc-500">{page.kicker}</p>
      <h1 class="mt-2 text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
        {page.greeting}<br />
        <span class="text-accent">{page.headline}</span>
      </h1>
      <p class="mt-4 text-zinc-600 dark:text-zinc-400" set:html={inline(page.intro)} />
      <Buttons buttons={page.buttons} />
    </div>
    <DotPad label={page.dotPadLabel} caption={page.dotPadCaption} />
  </section>

  <section class="mt-12" aria-labelledby="featured">
    <h2 id="featured" class="text-xl font-bold">{page.featuredTitle}</h2>
    {page.featuredNote && <p class="mt-1 text-sm text-zinc-500">{page.featuredNote}</p>}
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {featured.map((p) => <ProjectCard project={p} lang="en" />)}
    </div>
  </section>

  <section class="mt-16 grid gap-8 sm:grid-cols-2">
    <div>
      <h2 class="text-xl font-bold">{page.awardsTitle}</h2>
      <div class="mt-4"><ItemList items={awards} lang="en" /></div>
    </div>
    <div>
      <h2 class="text-xl font-bold">{page.certsTitle}</h2>
      <div class="mt-4"><ItemList items={certs} lang="en" /></div>
    </div>
  </section>
</Base>
