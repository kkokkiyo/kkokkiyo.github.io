---
import { getCollection, getEntry } from 'astro:content';
import { getFeaturedProjects } from '../data/featured';
import { PAGES } from '../data/pages';
import { inline } from '../data/inline';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DotPad from '../components/DotPad.astro';
import Buttons from '../components/Buttons.astro';

const home = PAGES.home;
const featured = await getFeaturedProjects();
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const logs = (await getCollection('logs')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const logRows = await Promise.all(logs.map(async (l) => ({ log: l, project: await getEntry(l.data.project) })));
const date = (d: Date) => d.toLocaleDateString('ko-KR');
---

<Base>
  <section class:list={['grid items-center gap-10 py-12', home.showDotPad && 'md:grid-cols-2']}>
    <div>
      <p class="text-sm text-zinc-500">{home.kicker}</p>
      <h1 class="mt-2 text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
        {home.greeting}<br />
        <span class="text-accent">{home.headline}</span>
      </h1>
      <p class="mt-4 text-zinc-600 dark:text-zinc-400" set:html={inline(home.intro)} />
      <Buttons buttons={home.buttons} />
    </div>
    {home.showDotPad && <DotPad label={home.dotPadLabel} />}
  </section>

  {
    home.sections.map((section, i) => {
      const id = `section-${i}`;
      if (section.type === 'featured')
        return (
          featured.length > 0 && (
            <section class="mt-12" aria-labelledby={id}>
              <h2 id={id} class="text-xl font-bold">{section.title}</h2>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {featured.slice(0, section.count ?? featured.length).map((p) => <ProjectCard project={p} />)}
              </div>
            </section>
          )
        );
      const items =
        section.type === 'posts'
          ? posts.map((p) => ({ href: `/blog/${p.id}/`, title: p.data.title, date: p.data.date }))
          : logRows.map(({ log, project }) => ({ href: `/projects/${project?.id}/`, title: log.data.title, date: log.data.date }));
      return (
        items.length > 0 && (
          <section class="mt-16" aria-labelledby={id}>
            <h2 id={id} class="text-xl font-bold">{section.title}</h2>
            <ul class="mt-4 divide-y divide-zinc-200 dark:divide-zinc-800">
              {items.slice(0, section.count ?? 3).map((item) => (
                <li class="py-3">
                  <a href={item.href} class="hover:text-accent">{item.title}</a>
                  <time class="ml-2 text-sm text-zinc-500" datetime={item.date.toISOString()}>{date(item.date)}</time>
                </li>
              ))}
            </ul>
          </section>
        )
      );
    })
  }
</Base>
