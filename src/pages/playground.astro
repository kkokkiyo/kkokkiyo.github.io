---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import PacmanDemo from '../components/PacmanDemo.astro';
import ImageConverter from '../components/ImageConverter.astro';
import { mdxComponents } from '../components/mdx';
import { inline } from '../data/inline';

type PlaygroundPage = { intro?: string; pacmanTab?: string; pacmanIntro?: string; imageTab?: string; imageIntro?: string; imageHowTo?: string };

const page = (await getEntry('pages', 'playground'))!;
const data = page.data as typeof page.data & PlaygroundPage;
const { Content } = await render(page);
const paragraphs = (text?: string) => (text ?? '').split(/\n\s*\n/).map((t) => t.trim()).filter(Boolean);
---

<Base title={page.data.title} description={page.data.description ?? undefined} og="playground">
  <h1 class="pt-8 text-3xl font-bold">{page.data.title}</h1>
  {data.intro && <p class="mt-3 text-zinc-600 dark:text-zinc-400" set:html={inline(data.intro)} />}

  <div role="tablist" aria-label="체험 고르기" class="mt-8 flex gap-2 border-b border-zinc-200 dark:border-zinc-800">
    <button type="button" role="tab" id="tab-pacman" aria-controls="panel-pacman" aria-selected="true" class="tab">{data.pacmanTab ?? 'Dot Pad 팩맨'}</button>
    <button type="button" role="tab" id="tab-image" aria-controls="panel-image" aria-selected="false" tabindex="-1" class="tab">{data.imageTab ?? '이미지 핀 변환'}</button>
  </div>

  <section id="panel-pacman" role="tabpanel" aria-labelledby="tab-pacman" class="pt-6">
    {data.pacmanIntro && <p class="text-zinc-600 dark:text-zinc-400" set:html={inline(data.pacmanIntro)} />}
    <PacmanDemo />
    <div class="mt-12"><Prose><Content components={mdxComponents} /></Prose></div>
  </section>

  <section id="panel-image" role="tabpanel" aria-labelledby="tab-image" class="pt-6" hidden>
    {data.imageIntro && <p class="mb-8 text-zinc-600 dark:text-zinc-400" set:html={inline(data.imageIntro)} />}
    <ImageConverter />
    {
      paragraphs(data.imageHowTo).length > 0 && (
        <div class="mt-12">
          <Prose>{paragraphs(data.imageHowTo).map((t) => <p set:html={inline(t)} />)}</Prose>
        </div>
      )
    }
  </section>
</Base>

<style>
  .tab {
    margin-bottom: -1px;
    border-bottom: 3px solid transparent;
    padding: 0.5rem 1rem;
    font-weight: 600;
    color: var(--color-zinc-500);
    cursor: pointer;
  }
  .tab[aria-selected='true'] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const select = (tab: HTMLButtonElement, focus = false) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
    if (focus) tab.focus();
    history.replaceState(null, '', tab.id === 'tab-image' ? '#image' : '#pacman');
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
    });
  });
  const fromHash = () => select(location.hash === '#image' ? tabs[1] : tabs[0]);
  if (location.hash) fromHash();
  addEventListener('hashchange', fromHash);
</script>
