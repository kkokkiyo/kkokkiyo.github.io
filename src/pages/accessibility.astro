---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import { mdxComponents } from '../components/mdx';

const page = (await getEntry('pages', 'accessibility'))!;
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description ?? undefined}>
  <h1 class="py-8 text-3xl font-bold">{page.data.title}</h1>
  <Prose><Content components={mdxComponents} /></Prose>
</Base>
