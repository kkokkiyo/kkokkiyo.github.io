---
import Base from '../layouts/Base.astro';
import { PAGES } from '../data/pages';

const page = PAGES.search;
---

<Base title={page.title} description={page.description}>
  <h1 class="py-8 text-3xl font-bold">{page.title}</h1>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div id="search" data-placeholder={page.placeholder} data-empty={page.empty}></div>
  <noscript>검색은 자바스크립트가 필요합니다.</noscript>
  <p id="search-dev" class="hidden text-sm text-zinc-500">검색 색인은 <code>npm run build</code> 후에 만들어집니다. 개발 서버에서는 동작하지 않아요.</p>
</Base>

<script is:inline>
  const s = document.createElement('script');
  s.src = '/pagefind/pagefind-ui.js';
  s.onload = () =>
    new PagefindUI({
      element: '#search',
      showSubResults: true,
      translations: { placeholder: document.getElementById('search').dataset.placeholder, zero_results: document.getElementById('search').dataset.empty },
    });
  s.onerror = () => document.getElementById('search-dev').classList.remove('hidden');
  document.head.append(s);
</script>

<style is:global>
  #search {
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-font: inherit;
  }
  [data-theme='dark'] #search {
    --pagefind-ui-text: #e4e4e7;
    --pagefind-ui-background: #09090b;
    --pagefind-ui-border: #3f3f46;
    --pagefind-ui-tag: #27272a;
  }
</style>
