---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import { mdxComponents } from '../components/mdx';

type TimelineItem = { period: string; title: string; body?: string | null; project?: string | null };
type Paper = { title: string; href: string; note?: string | null };

const page = (await getEntry('pages', 'research'))!;
const data = page.data as typeof page.data & {
  timeline?: TimelineItem[];
  logsTitle?: string;
  logsCount?: number;
  papersTitle?: string;
  papers?: Paper[];
};
const { Content } = await render(page);

const logs = (await getCollection('logs')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, data.logsCount ?? 8);
const logRows = await Promise.all(logs.map(async (l) => ({ log: l, project: await getEntry(l.data.project) })));
---

<Base title={data.title} description={data.description ?? undefined} og="research">
  <h1 class="py-8 text-3xl font-bold">{data.title}</h1>
  <Prose><Content components={mdxComponents} /></Prose>

  {
    (data.timeline ?? []).length > 0 && (
      <ol class="mt-10 border-l-2 border-zinc-200 dark:border-zinc-800">
        {data.timeline!.map((t) => (
          <li class="relative mb-8 pl-6">
            <span class="absolute -left-[7px] top-1.5 size-3 rounded-full bg-accent" aria-hidden="true" />
            <p class="text-sm text-zinc-500">{t.period}</p>
            <h2 class="font-semibold">{t.project ? <a href={`/projects/${t.project}/`} class="hover:text-accent">{t.title}</a> : t.title}</h2>
            {t.body && <p class="text-sm text-zinc-600 dark:text-zinc-400">{t.body}</p>}
          </li>
        ))}
      </ol>
    )
  }

  {
    logRows.length > 0 && (
      <section class="mt-16" aria-labelledby="log-heading">
        <h2 id="log-heading" class="text-xl font-bold">{data.logsTitle}</h2>
        <ul class="mt-4 divide-y divide-zinc-200 dark:divide-zinc-800">
          {logRows.map(({ log, project }) => (
            <li class="flex flex-wrap gap-x-4 py-3">
              <time class="w-24 shrink-0 text-sm text-zinc-500" datetime={log.data.date.toISOString()}>{log.data.date.toLocaleDateString('ko-KR')}</time>
              <span class="flex-1">
                {log.data.title} {project && <a href={`/projects/${project.id}/`} class="text-sm text-accent hover:underline">{project.data.title}</a>}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    (data.papers ?? []).length > 0 && (
      <section class="mt-16" aria-labelledby="papers-heading">
        <h2 id="papers-heading" class="text-xl font-bold">{data.papersTitle}</h2>
        {data.papers!.map((p) => (
          <p class="mt-2 text-zinc-600 dark:text-zinc-400">
            <a href={p.href} class="text-accent underline">{p.title}</a>
            {p.note && `: ${p.note}`}
          </p>
        ))}
      </section>
    )
  }
</Base>
