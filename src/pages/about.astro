---
import Base from '../layouts/Base.astro';
import ItemList from '../components/ItemList.astro';
import { SITE } from '../consts';
import { PAGES } from '../data/pages';
import { inline } from '../data/inline';
import { skills, awards, activities, certs, graduation } from '../data/profile';

const page = PAGES.about;
const sections = [
  { title: page.awardsTitle, items: awards },
  { title: page.activitiesTitle, items: activities },
  { title: page.certsTitle, items: certs },
].filter((s) => s.items.length > 0);
---

<Base title={page.title} description={page.description}>
  <h1 class="py-8 text-3xl font-bold">{page.title}</h1>
  <p class="text-lg" set:html={inline(page.intro)} />
  {page.showGraduation && graduation && <p class="mt-2 text-zinc-500">{graduation}</p>}
  {page.cvLinkLabel && <p class="mt-4"><a href="/cv/" class="text-accent hover:underline">{page.cvLinkLabel}</a></p>}

  <h2 class="mt-12 text-xl font-bold">{page.skillsTitle}</h2>
  <dl class="mt-4 grid gap-3 sm:grid-cols-[9rem_1fr]">
    {
      Object.entries(skills).map(([k, v]) => (
        <>
          <dt class="font-semibold">{k}</dt>
          <dd class="text-zinc-600 dark:text-zinc-400">{v.join(', ')}</dd>
        </>
      ))
    }
  </dl>

  {
    sections.map(({ title, items }) => (
      <section>
        <h2 class="mt-12 text-xl font-bold">{title}</h2>
        <div class="mt-4"><ItemList items={items} /></div>
      </section>
    ))
  }

  <h2 class="mt-12 text-xl font-bold">{page.contactTitle}</h2>
  <p class="mt-4">
    <a class="mr-4 text-accent hover:underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <a class="text-accent hover:underline" href={SITE.github}>GitHub</a>
  </p>
</Base>
