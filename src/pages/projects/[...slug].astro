---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import { mdxComponents } from '../../components/mdx';
import Badges from '../../components/Badges.astro';
import { CATEGORIES } from '../../consts';
import { projectBadges } from '../../data/badges';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const logs = (await getCollection('logs', ({ data }) => data.project.id === project.id)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const renderedLogs = await Promise.all(logs.map(async (log) => ({ log, Body: (await render(log)).Content })));
---

<Base title={data.title} description={data.summary} og={`projects/${project.id}`}>
  <article class="py-8">
    <p class="text-sm text-zinc-500">{CATEGORIES[data.category]} · {data.period}</p>
    <h1 class="mt-1 text-3xl font-bold">{data.title}</h1>
    <div class="mt-3"><Badges badges={projectBadges(project)} /></div>
    <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">{data.summary}</p>

    <dl class="mt-6 grid gap-3 rounded-xl bg-zinc-50 p-5 text-sm sm:grid-cols-[6rem_1fr] dark:bg-zinc-900">
      {data.award && (<><dt class="font-semibold">수상</dt><dd>{data.award}</dd></>)}
      {data.role && (<><dt class="font-semibold">역할</dt><dd>{data.role}</dd></>)}
      <dt class="font-semibold">기술</dt>
      <dd>{data.stack.join(' · ')}</dd>
      {data.highlights.length > 0 && (
        <>
          <dt class="font-semibold">성과</dt>
          <dd><ul class="list-disc pl-4">{data.highlights.map((h) => <li>{h}</li>)}</ul></dd>
        </>
      )}
      {(data.repo || data.demo) && (
        <>
          <dt class="font-semibold">링크</dt>
          <dd class="flex gap-3">
            {data.repo && <a class="text-accent hover:underline" href={data.repo}>GitHub</a>}
            {data.demo && <a class="text-accent hover:underline" href={data.demo}>Demo</a>}
          </dd>
        </>
      )}
    </dl>

    <div class="mt-10"><Prose><Content components={mdxComponents} /></Prose></div>

    {
      renderedLogs.length > 0 && (
        <section class="mt-16" aria-labelledby="log-heading">
          <h2 id="log-heading" class="text-xl font-bold">연구 로그</h2>
          <ol class="mt-6 border-l-2 border-zinc-200 dark:border-zinc-800">
            {renderedLogs.map(({ log, Body }) => (
              <li class="relative mb-8 pl-6">
                <span class="absolute -left-[7px] top-1.5 size-3 rounded-full bg-accent" aria-hidden="true" />
                <time class="text-sm text-zinc-500" datetime={log.data.date.toISOString()}>{log.data.date.toLocaleDateString('ko-KR')}</time>
                <h3 class="font-semibold">{log.data.title}</h3>
                <div class="text-sm text-zinc-600 dark:text-zinc-400"><Body /></div>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </article>
</Base>
