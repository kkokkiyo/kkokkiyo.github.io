---
import type { Badge } from '../data/badges';

interface Props {
  badges: Badge[];
}

const tones = {
  award: 'bg-amber-100 text-amber-900 dark:bg-amber-400/15 dark:text-amber-200',
  ongoing: 'bg-emerald-100 text-emerald-900 dark:bg-emerald-400/15 dark:text-emerald-200',
  lead: 'bg-sky-100 text-sky-900 dark:bg-sky-400/15 dark:text-sky-200',
};
const { badges } = Astro.props;
---

{
  badges.length > 0 && (
    <ul class="flex flex-wrap gap-1.5" aria-label="상태">
      {badges.map((b) => (
        <li class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium', tones[b.tone]]}>{b.label}</li>
      ))}
    </ul>
  )
}
