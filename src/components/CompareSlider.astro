---
// 두 이미지를 좌우로 밀어 비교하는 슬라이더
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { resolveImage } from '../data/images';

interface Props {
  before: ImageMetadata | string;
  after: ImageMetadata | string;
  beforeAlt: string;
  afterAlt: string;
  beforeLabel?: string;
  afterLabel?: string;
  /** 표시 비율 (예: 3 / 2) */
  aspect?: string;
}

const { before: beforeSrc, after: afterSrc, beforeAlt, afterAlt, beforeLabel = '원본', afterLabel = 'Dot Pad', aspect } = Astro.props;
const before = resolveImage(beforeSrc), after = resolveImage(afterSrc);
const [b, a] = await Promise.all([getImage({ src: before, format: 'webp' }), getImage({ src: after, format: 'webp' })]);
const ratio = aspect ?? `${before.width} / ${before.height}`;
---

<figure class="compare not-prose mx-auto my-8 max-w-xl">
  <div class="relative overflow-hidden rounded-xl bg-white select-none" style={`aspect-ratio: ${ratio}`}>
    <img src={a.src} alt={afterAlt} class="absolute inset-0 h-full w-full object-contain" loading="lazy" decoding="async" />
    <div class="clip absolute inset-0" style="clip-path: inset(0 50% 0 0)">
      <img src={b.src} alt={beforeAlt} class="h-full w-full bg-white object-contain" loading="lazy" decoding="async" />
    </div>
    <div class="divider pointer-events-none absolute inset-y-0 w-0.5 bg-accent" style="left: 50%" aria-hidden="true"></div>
    <span class="absolute left-2 top-2 rounded bg-black/70 px-2 py-0.5 text-xs text-white" aria-hidden="true">{beforeLabel}</span>
    <span class="absolute right-2 top-2 rounded bg-black/70 px-2 py-0.5 text-xs text-white" aria-hidden="true">{afterLabel}</span>
  </div>
  <label class="mt-3 flex items-center gap-3 text-sm text-zinc-500">
    <span class="shrink-0">{beforeLabel}</span>
    <input type="range" min="0" max="100" value="50" class="w-full accent-[var(--color-accent)]" aria-label={`${beforeLabel}과 ${afterLabel} 비교 위치`} />
    <span class="shrink-0">{afterLabel}</span>
  </label>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.compare').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('input[type=range]')!;
    const clip = el.querySelector<HTMLElement>('.clip')!;
    const divider = el.querySelector<HTMLElement>('.divider')!;
    const update = () => {
      clip.style.clipPath = `inset(0 ${100 - Number(range.value)}% 0 0)`;
      divider.style.left = `${range.value}%`;
    };
    range.addEventListener('input', update);
  });
</script>
